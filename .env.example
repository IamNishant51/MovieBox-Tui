# Copy to .env and fill in your Google OAuth credentials.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web app)
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
# 32+ hex chars: openssl rand -hex 32
SESSION_SECRET=change-me-to-32-plus-random-hex-chars-minimum
# Optional server bind overrides
HOST=127.0.0.1
PORT=3000
# development = everything open, no login needed (default).
# production = watching + library require Google login.
APP_MODE=development
